//@version=5
// Gold RSI Strategy — overlay=true (everything on main chart)
// You keep your own RSI. This indicator draws zones, signals, sessions on the chart.

indicator("Gold RSI Strategy", shorttitle="RSI Zones", overlay=true, max_boxes_count=100, max_labels_count=200, max_lines_count=200)

// === INPUTS ===
len30 = input.int(30, "RSI 30 Period")
osLevel = input.float(40.0, "Oversold")
obLevel = input.float(60.0, "Overbought")
tol = input.float(1.0, "Tolerance")
dojiThresh = input.float(0.10, "Doji Threshold")
showH4 = input.bool(true, "H4 Zones")
showD1 = input.bool(true, "Daily Zones")
showW1 = input.bool(true, "Weekly Zones")
zFilter = input.float(25.0, "Zone Filter %")
showSigs = input.bool(true, "Buy/Sell Signals")
showSess = input.bool(true, "Session Lines")
showDayMark = input.bool(true, "Day Markers")
pCorner = input.string("top_right", "Panel", options=["top_left","top_right","bottom_left","bottom_right"])

// === RSI (calculated internally, NOT plotted) ===
rsi30 = ta.rsi(close, len30)
rsi14 = ta.rsi(close, 14)

lo40 = osLevel - tol
hi40 = osLevel + tol
lo60 = obLevel - tol
hi60 = obLevel + tol
inZ40 = rsi30 >= lo40 and rsi30 <= hi40
inZ60 = rsi30 >= lo60 and rsi30 <= hi60

var int cz = 0
var int curZone = 0
if inZ40
    curZone := 40
    cz := cz + 1
else if inZ60
    curZone := 60
    cz := cz + 1
else
    cz := 0
    curZone := 0

// === BUY/SELL SIGNALS ===
buySig = inZ40 and not inZ40[1]
sellSig = inZ60 and not inZ60[1]
atrV = ta.atr(14)

plotshape(showSigs and buySig, title="Buy", style=shape.triangleup, location=location.belowbar, color=color.green, size=size.small, text="BUY", textcolor=color.green)
plotshape(showSigs and sellSig, title="Sell", style=shape.triangledown, location=location.abovebar, color=color.red, size=size.small, text="SELL", textcolor=color.red)

// === DOJI ZONES ===
[h4o,h4c,h4h,h4l,h4t] = request.security(syminfo.tickerid, "240", [open,close,high,low,time])
var float lH4 = na
newH4 = na(lH4) or h4t != lH4
lH4 := h4t
var bool h4D = false
var float h4DO = na
var float h4DC = na
if newH4 and not na(h4o[1])
    h4D := (h4h[1]-h4l[1]) > 0 and math.abs(h4c[1]-h4o[1]) <= dojiThresh * (h4h[1]-h4l[1])
    h4DO := h4o[1]
    h4DC := h4c[1]
if showH4 and h4D and not na(h4DO)
    zLo = math.min(h4DO, h4DC)
    zHi = math.max(h4DO, h4DC)
    if math.abs((h4DO+h4DC)/2 - close) / close * 100 <= zFilter
        box.new(bar_index-50, zHi, bar_index+100, zLo, border_color=color.rgb(140,165,215), border_width=1, bgcolor=color.rgb(140,165,215,80), extend=extend.right)
        label.new(bar_index-50, zHi, "H4 "+str.tostring(h4DO,"#.##")+"/"+str.tostring(h4DC,"#.##"), color=color.rgb(140,165,215), textcolor=color.white, style=label.style_label_down, size=size.tiny)

[d1o,d1c,d1h,d1l,d1t] = request.security(syminfo.tickerid, "D", [open,close,high,low,time])
var float lD1 = na
newD1 = na(lD1) or d1t != lD1
lD1 := d1t
var bool d1D = false
var float d1DO = na
var float d1DC = na
if newD1 and not na(d1o[1])
    d1D := (d1h[1]-d1l[1]) > 0 and math.abs(d1c[1]-d1o[1]) <= dojiThresh * (d1h[1]-d1l[1])
    d1DO := d1o[1]
    d1DC := d1c[1]
if showD1 and d1D and not na(d1DO)
    zLo = math.min(d1DO, d1DC)
    zHi = math.max(d1DO, d1DC)
    if math.abs((d1DO+d1DC)/2 - close) / close * 100 <= zFilter
        box.new(bar_index-50, zHi, bar_index+100, zLo, border_color=color.rgb(165,175,155), border_width=1, bgcolor=color.rgb(165,175,155,80), extend=extend.right)
        label.new(bar_index-50, zHi, "D "+str.tostring(d1DO,"#.##")+"/"+str.tostring(d1DC,"#.##"), color=color.rgb(165,175,155), textcolor=color.white, style=label.style_label_down, size=size.tiny)

[w1o,w1c,w1h,w1l,w1t] = request.security(syminfo.tickerid, "W", [open,close,high,low,time])
var float lW1 = na
newW1 = na(lW1) or w1t != lW1
lW1 := w1t
var bool w1D = false
var float w1DO = na
var float w1DC = na
if newW1 and not na(w1o[1])
    w1D := (w1h[1]-w1l[1]) > 0 and math.abs(w1c[1]-w1o[1]) <= dojiThresh * (w1h[1]-w1l[1])
    w1DO := w1o[1]
    w1DC := w1c[1]
if showW1 and w1D and not na(w1DO)
    zLo = math.min(w1DO, w1DC)
    zHi = math.max(w1DO, w1DC)
    if math.abs((w1DO+w1DC)/2 - close) / close * 100 <= zFilter
        box.new(bar_index-50, zHi, bar_index+100, zLo, border_color=color.rgb(235,155,70), border_width=1, bgcolor=color.rgb(235,155,70,80), extend=extend.right)
        label.new(bar_index-50, zHi, "W "+str.tostring(w1DO,"#.##")+"/"+str.tostring(w1DC,"#.##"), color=color.rgb(235,155,70), textcolor=color.white, style=label.style_label_down, size=size.tiny)

// === DAY MARKERS ===
hi50 = ta.highest(high, 50)
lo50 = ta.lowest(low, 50)
newDay = ta.change(time("D")) != 0
if showDayMark and newDay
    line.new(bar_index, hi50, bar_index, lo50, color=color.new(color.gray,70), style=line.style_dotted, width=1)
    label.new(bar_index, hi50, str.tostring(dayofmonth), color=color.new(color.gray,40), textcolor=color.gray, style=label.style_label_down, size=size.tiny)

// === SESSION MARKERS ===
cH = hour(time)
newH = ta.change(cH) != 0
if showSess and newH and cH == 0
    line.new(bar_index, hi50, bar_index, lo50, color=color.new(color.teal,50), style=line.style_dashed, width=1)
    label.new(bar_index, hi50, "Asia", color=color.teal, textcolor=color.white, style=label.style_label_down, size=size.tiny)
if showSess and newH and cH == 7
    line.new(bar_index, hi50, bar_index, lo50, color=color.new(color.orange,50), style=line.style_dashed, width=1)
    label.new(bar_index, hi50, "EU", color=color.orange, textcolor=color.white, style=label.style_label_down, size=size.tiny)
if showSess and newH and cH == 13
    line.new(bar_index, hi50, bar_index, lo50, color=color.new(color.red,50), style=line.style_dashed, width=1)
    label.new(bar_index, hi50, "US", color=color.red, textcolor=color.white, style=label.style_label_down, size=size.tiny)
if showSess and newH and cH == 21
    line.new(bar_index, hi50, bar_index, lo50, color=color.new(color.gray,70), style=line.style_dotted, width=1)

// === PANEL ===
d40 = math.abs(rsi30 - osLevel)
d60 = math.abs(rsi30 - obLevel)
likely = d40 < d60 ? 40 : 60
rsiVel = rsi30 - rsi30[10]
mRC = likely == 40 ? 1.61 : 1.54
mRV = likely == 40 ? -2.03 : 1.67
mDC = likely == 40 ? 2.78 : 2.17
mDV = likely == 40 ? -3.45 : 3.05
mPC = likely == 40 ? 1.78 : 1.83
mPV = likely == 40 ? -3.40 : 2.16
dR = math.sqrt(math.pow((cz-mRC)/3.0,2)*3.0 + math.pow((rsiVel-mRV)/4.0,2))
dD = math.sqrt(math.pow((cz-mDC)/3.0,2)*3.0 + math.pow((rsiVel-mDV)/4.0,2))
dP = math.sqrt(math.pow((cz-mPC)/3.0,2)*3.0 + math.pow((rsiVel-mPV)/4.0,2))
iR = 1.0/(dR+0.3)
iD = 1.0/(dD+0.3)
iP = 1.0/(dP+0.3)
sI = iR+iD+iP
rR = 0.329*(iR/(sI/3.0))
rD = 0.210*(iD/(sI/3.0))
rP = 0.461*(iP/(sI/3.0))
sR = rR+rD+rP
pR = rR/sR
pD = rD/sR
pP = rP/sR

patN = (high-low) > 0 and math.abs(close-open) <= (high-low)*0.10 ? "Doji" : (high-low) > 0 and (math.min(open,close)-low) >= (high-low)*0.6 and math.abs(close-open) <= (high-low)*0.35 ? "Bull Pin" : "None"

slP = curZone == 60 ? close+close*0.004 : curZone == 40 ? close-close*0.004 : na
tpP = curZone == 60 ? close-close*0.008 : curZone == 40 ? close+close*0.008 : na
rrR = curZone > 0 and not na(slP) ? math.abs(tpP-close)/math.abs(close-slP) : na
dirT = curZone == 60 ? "SELL" : curZone == 40 ? "BUY" : "-"

tP = pCorner == "top_left" ? position.top_left : pCorner == "top_right" ? position.top_right : pCorner == "bottom_left" ? position.bottom_left : position.bottom_right
var table pnl = table.new(tP, 2, 14, border_width=1, border_color=color.rgb(180,175,170))
if barstate.islast
    bg = color.rgb(250,249,246)
    lc = color.rgb(120,115,110)
    vc = color.rgb(50,45,40)
    table.cell(pnl,0,0,"Gold RSI Strategy",text_color=color.rgb(80,75,70),text_size=size.normal,bgcolor=bg)
    table.cell(pnl,1,0,"",bgcolor=bg)
    table.cell(pnl,0,1,"Price",text_color=lc,text_size=size.small,bgcolor=bg)
    table.cell(pnl,1,1,str.tostring(close,"#.##"),text_color=vc,text_size=size.small,bgcolor=bg)
    rc = rsi30 > 60 ? color.rgb(181,107,107) : rsi30 < 40 ? color.rgb(91,140,90) : vc
    table.cell(pnl,0,2,"RSI(30)",text_color=lc,text_size=size.small,bgcolor=bg)
    table.cell(pnl,1,2,str.tostring(rsi30,"#.##"),text_color=rc,text_size=size.small,bgcolor=bg)
    table.cell(pnl,0,3,"RSI(14)",text_color=lc,text_size=size.small,bgcolor=bg)
    table.cell(pnl,1,3,str.tostring(rsi14,"#.##"),text_color=color.rgb(150,145,140),text_size=size.small,bgcolor=bg)
    zT = curZone > 0 ? "Zone "+str.tostring(curZone)+" ("+str.tostring(cz)+")" : "Near "+str.tostring(likely)+" ("+str.tostring(math.min(d40,d60),"#.#")+")"
    table.cell(pnl,0,4,"Zone",text_color=lc,text_size=size.small,bgcolor=bg)
    table.cell(pnl,1,4,zT,text_color=color.rgb(150,145,140),text_size=size.small,bgcolor=bg)
    table.cell(pnl,0,5,"Likely",text_color=lc,text_size=size.small,bgcolor=bg)
    table.cell(pnl,1,5,str.tostring(likely),text_color=color.rgb(80,80,110),text_size=size.small,bgcolor=bg)
    table.cell(pnl,0,6,"Reversal",text_color=lc,text_size=size.small,bgcolor=bg)
    table.cell(pnl,1,6,str.tostring(pR*100,"#")+"%",text_color=color.rgb(91,140,90),text_size=size.small,bgcolor=bg)
    table.cell(pnl,0,7,"Divergence",text_color=lc,text_size=size.small,bgcolor=bg)
    table.cell(pnl,1,7,str.tostring(pD*100,"#")+"%",text_color=color.rgb(192,138,90),text_size=size.small,bgcolor=bg)
    table.cell(pnl,0,8,"Pass",text_color=lc,text_size=size.small,bgcolor=bg)
    table.cell(pnl,1,8,str.tostring(pP*100,"#")+"%",text_color=color.rgb(181,107,107),text_size=size.small,bgcolor=bg)
    table.cell(pnl,0,9,"Pattern",text_color=lc,text_size=size.small,bgcolor=bg)
    table.cell(pnl,1,9,patN,text_color=patN != "None" ? color.rgb(192,138,90) : color.rgb(150,145,140),text_size=size.small,bgcolor=bg)
    if curZone > 0
        table.cell(pnl,0,10,"Direction",text_color=lc,text_size=size.small,bgcolor=bg)
        table.cell(pnl,1,10,dirT,text_color=dirT == "BUY" ? color.rgb(91,140,90) : color.rgb(181,107,107),text_size=size.small,bgcolor=bg)
        table.cell(pnl,0,11,"Entry",text_color=lc,text_size=size.small,bgcolor=bg)
        table.cell(pnl,1,11,str.tostring(close,"#.##"),text_color=vc,text_size=size.small,bgcolor=bg)
        table.cell(pnl,0,12,"SL/TP",text_color=lc,text_size=size.small,bgcolor=bg)
        table.cell(pnl,1,12,str.tostring(slP,"#.##")+"/"+str.tostring(tpP,"#.##"),text_color=vc,text_size=size.small,bgcolor=bg)
        table.cell(pnl,0,13,"R:R",text_color=lc,text_size=size.small,bgcolor=bg)
        table.cell(pnl,1,13,"1:"+str.tostring(rrR,"#.##"),text_color=color.rgb(192,138,90),text_size=size.small,bgcolor=bg)

// === ALERTS ===
alertcondition(buySig, "Buy Zone 40", "RSI entered zone 40")
alertcondition(sellSig, "Sell Zone 60", "RSI entered zone 60")
alertcondition(h4D and newH4, "H4 Doji", "H4 Doji formed")
alertcondition(d1D and newD1, "Daily Doji", "Daily Doji formed")
alertcondition(w1D and newW1, "Weekly Doji", "Weekly Doji formed")
