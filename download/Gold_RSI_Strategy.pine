//@version=5
// Gold RSI Strategy — 8 signal types
// First Touch + Turn + Divergence + Strong Rev + Momentum + Confirm + Zone Swing + Trend + Weak Div
// Based on 2-year statistical backtest findings

indicator("Gold RSI Strategy", shorttitle="RSI Signals", overlay=true, max_labels_count=500, max_lines_count=200)

// === INPUTS ===
len30 = input.int(30, "RSI 30 Period")
osLevel = input.float(40.0, "Oversold")
obLevel = input.float(60.0, "Overbought")
tol = input.float(1.0, "Tolerance")
showSigs = input.bool(true, "First Touch")
showTurn = input.bool(true, "Turn")
showDiv = input.bool(true, "Divergence (near zone)")
showWeak = input.bool(true, "Weak Divergence (outside zone)")
showStrong = input.bool(true, "Strong Reversal (5+ bars)")
showMom = input.bool(true, "Momentum Warning")
showConfirm = input.bool(true, "Confirm (first candle after touch)")
showSwing = input.bool(true, "Zone Swing (60->40 or 40->60)")
showTrend = input.bool(true, "Trend Cross (RSI 50)")
showSess = input.bool(true, "Session Backgrounds")
showDayMark = input.bool(true, "Day Markers")
divRange = input.int(50, "Divergence Range")
pCorner = input.string("top_right", "Panel", options=["top_left","top_right","bottom_left","bottom_right"])

// === RSI ===
rsi30 = ta.rsi(close, len30)
rsi14 = ta.rsi(close, 14)
lo40 = osLevel - tol
hi40 = osLevel + tol
lo60 = obLevel - tol
hi60 = obLevel + tol
inZ40 = rsi30 >= lo40 and rsi30 <= hi40
inZ60 = rsi30 >= lo60 and rsi30 <= hi60

var int cz = 0
var int curZone = 0
if inZ40
    curZone := 40
    cz := cz + 1
else if inZ60
    curZone := 60
    cz := cz + 1
else
    cz := 0
    curZone := 0

// === VOLUME RATIO ===
vol5 = ta.sma(volume, 5)
vol20 = ta.sma(volume, 20)
volRatio = vol20 > 0 ? vol5 / vol20 : 1.0

// === TRACK ZONE TOUCHES ===
var int barsSinceT40 = 999
var int barsSinceT60 = 999
firstTouch40 = inZ40 and not inZ40[1]
firstTouch60 = inZ60 and not inZ60[1]
if firstTouch40
    barsSinceT40 := 0
if firstTouch60
    barsSinceT60 := 0
barsSinceT40 := barsSinceT40 + 1
barsSinceT60 := barsSinceT60 + 1
if rsi30 > 55
    barsSinceT40 := 999
if rsi30 < 45
    barsSinceT60 := 999

// === PATTERN DETECTION ===
cBody = math.abs(close - open)
cRng = high - low
isDoji = cRng > 0 and cBody <= cRng * 0.10
isBullPin = cRng > 0 and (math.min(open, close) - low) >= cRng * 0.6 and cBody <= cRng * 0.35
isBearPin = cRng > 0 and (high - math.max(open, close)) >= cRng * 0.6 and cBody <= cRng * 0.35
isBullEng = close[1] < open[1] and close > open and math.max(open, close) >= math.max(open[1], close[1]) and math.min(open, close) <= math.min(open[1], close[1])
isBearEng = close[1] > open[1] and close < open and math.max(open, close) >= math.max(open[1], close[1]) and math.min(open, close) <= math.min(open[1], close[1])
hasPattern = isDoji or isBullPin or isBearPin or isBullEng or isBearEng

// === ATR + OVERLAP TRACKING ===
atrV = ta.atr(14)
var int sigCountThisBar = 0
sigCountThisBar := 0

// === SIGNAL 1: FIRST TOUCH ===
buySig = firstTouch40 and (hasPattern or cz >= 2)
sellSig = firstTouch60 and (hasPattern or cz >= 2)
if showSigs and buySig
    sigCountThisBar := sigCountThisBar + 1
    label.new(bar_index, low - atrV * 0.5 * sigCountThisBar, "First Touch", style=label.style_label_up, color=color.green, textcolor=color.white, size=size.tiny)
if showSigs and sellSig
    sigCountThisBar := sigCountThisBar + 1
    label.new(bar_index, high + atrV * 0.5 * sigCountThisBar, "First Touch", style=label.style_label_down, color=color.red, textcolor=color.white, size=size.tiny)

// === SIGNAL 2: TURN ===
turn40Up = not inZ40 and inZ40[1] and rsi30 > hi40
turn60Down = not inZ60 and inZ60[1] and rsi30 < lo60
if showTurn and turn40Up
    sigCountThisBar := sigCountThisBar + 1
    label.new(bar_index, low - atrV * 0.5 * sigCountThisBar, "Turn", style=label.style_label_up, color=color.rgb(0, 160, 0), textcolor=color.white, size=size.tiny)
if showTurn and turn60Down
    sigCountThisBar := sigCountThisBar + 1
    label.new(bar_index, high + atrV * 0.5 * sigCountThisBar, "Turn", style=label.style_label_down, color=color.rgb(200, 0, 0), textcolor=color.white, size=size.tiny)

// === SIGNAL 3+8: DIVERGENCE (strong near zone + weak outside zone) ===
plR = ta.pivotlow(rsi30, 5, 5)
phR = ta.pivothigh(rsi30, 5, 5)
plP = ta.pivotlow(low, 5, 5)
phP = ta.pivothigh(high, 5, 5)

var float lastPL_price = na
var float lastPL_rsi = na
var float lastPH_price = na
var float lastPH_rsi = na

bullDiv = false
bearDiv = false
bullDivWeak = false
bearDivWeak = false

if not na(plP) and not na(plR)
    if not na(lastPL_price) and not na(lastPL_rsi)
        if plP < lastPL_price and plR > lastPL_rsi
            if barsSinceT40 <= divRange and rsi30 < 50
                bullDiv := true
            else
                bullDivWeak := true
    lastPL_price := plP
    lastPL_rsi := plR

if not na(phP) and not na(phR)
    if not na(lastPH_price) and not na(lastPH_rsi)
        if phP > lastPH_price and phR < lastPH_rsi
            if barsSinceT60 <= divRange and rsi30 > 50
                bearDiv := true
            else
                bearDivWeak := true
    lastPH_price := phP
    lastPH_rsi := phR

if showDiv and bullDiv
    sigCountThisBar := sigCountThisBar + 1
    label.new(bar_index, low - atrV * 0.5 * sigCountThisBar, "Divergence", style=label.style_label_up, color=color.blue, textcolor=color.white, size=size.tiny)
if showDiv and bearDiv
    sigCountThisBar := sigCountThisBar + 1
    label.new(bar_index, high + atrV * 0.5 * sigCountThisBar, "Divergence", style=label.style_label_down, color=color.orange, textcolor=color.white, size=size.tiny)

if showWeak and bullDivWeak
    sigCountThisBar := sigCountThisBar + 1
    label.new(bar_index, low - atrV * 0.5 * sigCountThisBar, "Weak Div", style=label.style_label_up, color=color.new(color.blue, 40), textcolor=color.white, size=size.tiny)
if showWeak and bearDivWeak
    sigCountThisBar := sigCountThisBar + 1
    label.new(bar_index, high + atrV * 0.5 * sigCountThisBar, "Weak Div", style=label.style_label_down, color=color.new(color.orange, 40), textcolor=color.white, size=size.tiny)

// === SIGNAL 4: STRONG REVERSAL ===
strongRev40 = inZ40 and cz == 5
strongRev60 = inZ60 and cz == 5
if showStrong and strongRev40
    sigCountThisBar := sigCountThisBar + 1
    label.new(bar_index, low - atrV * 0.5 * sigCountThisBar, "Strong Rev", style=label.style_label_up, color=color.rgb(0, 200, 100), textcolor=color.white, size=size.tiny)
if showStrong and strongRev60
    sigCountThisBar := sigCountThisBar + 1
    label.new(bar_index, high + atrV * 0.5 * sigCountThisBar, "Strong Rev", style=label.style_label_down, color=color.rgb(220, 50, 50), textcolor=color.white, size=size.tiny)

// === SIGNAL 5: MOMENTUM WARNING ===
momWarning = volRatio > 1.3 and (inZ40 or inZ60) and cz == 1
if showMom and momWarning and curZone == 40
    sigCountThisBar := sigCountThisBar + 1
    label.new(bar_index, high + atrV * 0.5 * sigCountThisBar, "Momentum", style=label.style_label_down, color=color.purple, textcolor=color.white, size=size.tiny)
if showMom and momWarning and curZone == 60
    sigCountThisBar := sigCountThisBar + 1
    label.new(bar_index, low - atrV * 0.5 * sigCountThisBar, "Momentum", style=label.style_label_up, color=color.purple, textcolor=color.white, size=size.tiny)

// === SIGNAL 7: CONFIRM (first candle after zone touch) ===
// Backtest: after zone 40, 55% next candle bullish. After zone 60, 56% bearish.
var bool wasInZ40 = false
var bool wasInZ60 = false
confirmBuy = wasInZ40 and not inZ40 and close > open
confirmSell = wasInZ60 and not inZ60 and close < open
wasInZ40 := inZ40
wasInZ60 := inZ60

if showConfirm and confirmBuy
    sigCountThisBar := sigCountThisBar + 1
    label.new(bar_index, low - atrV * 0.5 * sigCountThisBar, "Confirm", style=label.style_label_up, color=color.rgb(0, 200, 150), textcolor=color.white, size=size.tiny)
if showConfirm and confirmSell
    sigCountThisBar := sigCountThisBar + 1
    label.new(bar_index, high + atrV * 0.5 * sigCountThisBar, "Confirm", style=label.style_label_down, color=color.rgb(220, 100, 100), textcolor=color.white, size=size.tiny)

// === SIGNAL 8: ZONE SWING (RSI goes 60->40 or 40->60 within 48h) ===
// Backtest: 60->40 swing has 41.9% reversal rate (vs 33% baseline)
var int lastZone = 0
var int lastZoneBar = 0
swingSignal = false
swingDir = 0

if firstTouch40 or firstTouch60
    if lastZone > 0 and lastZone != curZone and (bar_index - lastZoneBar) <= 96
        swingSignal := true
        swingDir := curZone
    lastZone := curZone
    lastZoneBar := bar_index

if showSwing and swingSignal and swingDir == 40
    sigCountThisBar := sigCountThisBar + 1
    label.new(bar_index, low - atrV * 0.5 * sigCountThisBar, "Zone Swing", style=label.style_label_up, color=color.rgb(100, 200, 255), textcolor=color.white, size=size.tiny)
if showSwing and swingSignal and swingDir == 60
    sigCountThisBar := sigCountThisBar + 1
    label.new(bar_index, high + atrV * 0.5 * sigCountThisBar, "Zone Swing", style=label.style_label_down, color=color.rgb(255, 150, 50), textcolor=color.white, size=size.tiny)

// === SIGNAL 9: TREND CROSS (RSI crosses 50) ===
cross50Up = ta.crossover(rsi30, 50)
cross50Down = ta.crossunder(rsi30, 50)
if showTrend and cross50Up
    sigCountThisBar := sigCountThisBar + 1
    label.new(bar_index, low - atrV * 0.5 * sigCountThisBar, "Trend Up", style=label.style_label_up, color=color.rgb(50, 180, 50), textcolor=color.white, size=size.tiny)
if showTrend and cross50Down
    sigCountThisBar := sigCountThisBar + 1
    label.new(bar_index, high + atrV * 0.5 * sigCountThisBar, "Trend Down", style=label.style_label_down, color=color.rgb(200, 50, 50), textcolor=color.white, size=size.tiny)

// === SESSION BACKGROUNDS ===
cH = hour(time)
bgcolor(showSess and cH >= 0 and cH < 7 ? color.new(color.teal, 93) : na, title="Asia")
bgcolor(showSess and cH >= 7 and cH < 13 ? color.new(color.orange, 93) : na, title="Europe")
bgcolor(showSess and cH >= 13 and cH < 21 ? color.new(color.red, 93) : na, title="US")

// === DAY MARKERS ===
hi50 = ta.highest(high, 50)
lo50 = ta.lowest(low, 50)
newDay = ta.change(time("D")) != 0
if showDayMark and newDay
    line.new(bar_index, hi50, bar_index, lo50, color=color.new(color.gray, 70), style=line.style_dotted, width=1)
    label.new(bar_index, hi50, "Day " + str.tostring(dayofmonth), color=color.new(color.gray, 30), textcolor=color.gray, style=label.style_label_down, size=size.tiny)

// === PANEL ===
d40 = math.abs(rsi30 - osLevel)
d60 = math.abs(rsi30 - obLevel)
likely = d40 < d60 ? 40 : 60
rsiVel = rsi30 - rsi30[10]
mRC = likely == 40 ? 1.61 : 1.54
mRV = likely == 40 ? -2.03 : 1.67
mDC = likely == 40 ? 2.78 : 2.17
mDV = likely == 40 ? -3.45 : 3.05
mPC = likely == 40 ? 1.78 : 1.83
mPV = likely == 40 ? -3.40 : 2.16
dR = math.sqrt(math.pow((cz-mRC)/3.0,2)*3.0 + math.pow((rsiVel-mRV)/4.0,2))
dD = math.sqrt(math.pow((cz-mDC)/3.0,2)*3.0 + math.pow((rsiVel-mDV)/4.0,2))
dP = math.sqrt(math.pow((cz-mPC)/3.0,2)*3.0 + math.pow((rsiVel-mPV)/4.0,2))
iR = 1.0/(dR+0.3)
iD = 1.0/(dD+0.3)
iP = 1.0/(dP+0.3)
sI = iR+iD+iP
rR = 0.329*(iR/(sI/3.0))
rD = 0.210*(iD/(sI/3.0))
rP = 0.461*(iP/(sI/3.0))
sR = rR+rD+rP
pR = rR/sR
pD = rD/sR
pP = rP/sR

patN = isDoji ? "Doji" : isBullPin ? "Bull Pin" : isBearPin ? "Bear Pin" : isBullEng ? "Bull Engulf" : isBearEng ? "Bear Engulf" : "None"
slP = curZone == 60 ? close+close*0.004 : curZone == 40 ? close-close*0.004 : na
tpP = curZone == 60 ? close-close*0.008 : curZone == 40 ? close+close*0.008 : na
rrR = curZone > 0 and not na(slP) ? math.abs(tpP-close)/math.abs(close-slP) : na
dirT = curZone == 60 ? "SELL" : curZone == 40 ? "BUY" : "-"

tP = pCorner == "top_left" ? position.top_left : pCorner == "top_right" ? position.top_right : pCorner == "bottom_left" ? position.bottom_left : position.bottom_right
var table pnl = table.new(tP, 2, 18, border_width=1, border_color=color.rgb(180,175,170))
if barstate.islast
    bg = color.rgb(250,249,246)
    lc = color.rgb(120,115,110)
    vc = color.rgb(50,45,40)
    table.cell(pnl,0,0,"Gold RSI Strategy",text_color=color.rgb(80,75,70),text_size=size.normal,bgcolor=bg)
    table.cell(pnl,1,0,"",bgcolor=bg)
    table.cell(pnl,0,1,"Price",text_color=lc,text_size=size.small,bgcolor=bg)
    table.cell(pnl,1,1,str.tostring(close,"#.##"),text_color=vc,text_size=size.small,bgcolor=bg)
    rc = rsi30 > 60 ? color.rgb(181,107,107) : rsi30 < 40 ? color.rgb(91,140,90) : vc
    table.cell(pnl,0,2,"RSI(30)",text_color=lc,text_size=size.small,bgcolor=bg)
    table.cell(pnl,1,2,str.tostring(rsi30,"#.##"),text_color=rc,text_size=size.small,bgcolor=bg)
    table.cell(pnl,0,3,"RSI(14)",text_color=lc,text_size=size.small,bgcolor=bg)
    table.cell(pnl,1,3,str.tostring(rsi14,"#.##"),text_color=color.rgb(150,145,140),text_size=size.small,bgcolor=bg)
    zT = curZone > 0 ? "Zone "+str.tostring(curZone)+" ("+str.tostring(cz)+")" : "Near "+str.tostring(likely)+" ("+str.tostring(math.min(d40,d60),"#.#")+")"
    table.cell(pnl,0,4,"Zone",text_color=lc,text_size=size.small,bgcolor=bg)
    table.cell(pnl,1,4,zT,text_color=color.rgb(150,145,140),text_size=size.small,bgcolor=bg)
    table.cell(pnl,0,5,"Reversal",text_color=lc,text_size=size.small,bgcolor=bg)
    table.cell(pnl,1,5,str.tostring(pR*100,"#")+"%",text_color=color.rgb(91,140,90),text_size=size.small,bgcolor=bg)
    table.cell(pnl,0,6,"Divergence",text_color=lc,text_size=size.small,bgcolor=bg)
    table.cell(pnl,1,6,str.tostring(pD*100,"#")+"%",text_color=color.rgb(192,138,90),text_size=size.small,bgcolor=bg)
    table.cell(pnl,0,7,"Pass",text_color=lc,text_size=size.small,bgcolor=bg)
    table.cell(pnl,1,7,str.tostring(pP*100,"#")+"%",text_color=color.rgb(181,107,107),text_size=size.small,bgcolor=bg)
    table.cell(pnl,0,8,"Pattern",text_color=lc,text_size=size.small,bgcolor=bg)
    table.cell(pnl,1,8,patN,text_color=patN != "None" ? color.rgb(192,138,90) : color.rgb(150,145,140),text_size=size.small,bgcolor=bg)
    table.cell(pnl,0,9,"Vol Ratio",text_color=lc,text_size=size.small,bgcolor=bg)
    table.cell(pnl,1,9,str.tostring(volRatio,"#.##"),text_color=volRatio > 1.3 ? color.rgb(181,107,107) : color.rgb(150,145,140),text_size=size.small,bgcolor=bg)
    table.cell(pnl,0,10,"Bars in Zone",text_color=lc,text_size=size.small,bgcolor=bg)
    table.cell(pnl,1,10,str.tostring(cz),text_color=cz >= 5 ? color.rgb(91,140,90) : color.rgb(150,145,140),text_size=size.small,bgcolor=bg)

    if curZone > 0
        table.cell(pnl,0,12,"Direction",text_color=lc,text_size=size.small,bgcolor=bg)
        table.cell(pnl,1,12,dirT,text_color=dirT == "BUY" ? color.rgb(91,140,90) : color.rgb(181,107,107),text_size=size.small,bgcolor=bg)
        table.cell(pnl,0,13,"Entry",text_color=lc,text_size=size.small,bgcolor=bg)
        table.cell(pnl,1,13,str.tostring(close,"#.##"),text_color=vc,text_size=size.small,bgcolor=bg)
        table.cell(pnl,0,14,"SL/TP",text_color=lc,text_size=size.small,bgcolor=bg)
        table.cell(pnl,1,14,str.tostring(slP,"#.##")+"/"+str.tostring(tpP,"#.##"),text_color=vc,text_size=size.small,bgcolor=bg)
        table.cell(pnl,0,15,"R:R",text_color=lc,text_size=size.small,bgcolor=bg)
        table.cell(pnl,1,15,"1:"+str.tostring(rrR,"#.##"),text_color=color.rgb(192,138,90),text_size=size.small,bgcolor=bg)

// === ALERTS ===
alertcondition(buySig, "Buy First Touch", "RSI zone 40 — First Touch")
alertcondition(sellSig, "Sell First Touch", "RSI zone 60 — First Touch")
alertcondition(turn40Up, "Turn Buy", "RSI turned up from zone 40")
alertcondition(turn60Down, "Turn Sell", "RSI turned down from zone 60")
alertcondition(bullDiv, "Bull Divergence", "Bullish divergence near zone 40")
alertcondition(bearDiv, "Bear Divergence", "Bearish divergence near zone 60")
alertcondition(bullDivWeak, "Weak Bull Div", "Weak bullish divergence outside zone")
alertcondition(bearDivWeak, "Weak Bear Div", "Weak bearish divergence outside zone")
alertcondition(strongRev40, "Strong Reversal Buy", "5+ bars in zone 40")
alertcondition(strongRev60, "Strong Reversal Sell", "5+ bars in zone 60")
alertcondition(momWarning, "Momentum", "High volume momentum warning")
alertcondition(confirmBuy, "Confirm Buy", "Bullish candle after zone 40 — confirm")
alertcondition(confirmSell, "Confirm Sell", "Bearish candle after zone 60 — confirm")
alertcondition(swingSignal and swingDir == 40, "Zone Swing Buy", "RSI swung 60->40 — high reversal probability")
alertcondition(swingSignal and swingDir == 60, "Zone Swing Sell", "RSI swung 40->60 — high reversal probability")
alertcondition(cross50Up, "Trend Up", "RSI crossed above 50")
alertcondition(cross50Down, "Trend Down", "RSI crossed below 50")
